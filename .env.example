# Application
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-value
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL + pgvector
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticotalento

# LLM and embeddings (never commit real values)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=

# Google Drive service account
GOOGLE_DRIVE_FOLDER_ID=
PORT=3001
